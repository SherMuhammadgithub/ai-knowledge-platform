{
  "name": "@akp/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "node --env-file=../../.env dist/main.js",
    "start:dev": "nest start --watch --exec \"node --env-file=../../.env\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "bun --env-file=../../.env run src/scripts/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "list:models": "bun --env-file=../../.env run src/scripts/list-models.ts",
    "smoke:gemini": "bun --env-file=../../.env run src/scripts/smoke-gemini.ts",
    "lab:embeddings": "bun --env-file=../../.env run src/scripts/embedding-lab.ts",
    "worker": "nest start --entryFile worker --path tsconfig.worker.json --exec \"node --env-file=../../.env\"",
    "worker:dev": "nest start --watch --entryFile worker --path tsconfig.worker.json --exec \"node --env-file=../../.env\"",
    "start:worker": "node --env-file=../../.env dist-worker/worker.js",
    "samples": "bun run src/scripts/make-demo-files.ts"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.3",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "^6.3.8",
    "cookie-parser": "^1.4.7",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pdf-lib": "^1.17.1",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "typescript": "^6",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  }
}
