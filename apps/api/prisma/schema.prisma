// Tenant model. A Workspace is the tenant. Every tenant-owned table added in later milestones
// (documents, chunks, conversations, eval data) carries a workspace_id and is only ever read
// through the workspace-scoped client. See docs/PLAN.md and CLAUDE.md "Tenant isolation".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum DocumentType {
  PDF
  DOCX
  TXT
}

// uploaded -> processing -> ready | failed. Milestone 3 only ever writes UPLOADED. The worker (M4) does the rest.
enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model User {
  id           String   @id @default(uuid(7))
  email        String   @unique // always stored lowercase
  passwordHash String   @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")

  memberships Membership[]
  documents   Document[]

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid(7))
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  memberships    Membership[]
  documents      Document[]
  documentPages  DocumentPage[]
  documentChunks DocumentChunk[]

  @@map("workspaces")
}

// A user can belong to several workspaces. Role is per workspace.
model Membership {
  id          String        @id @default(uuid(7))
  userId      String        @map("user_id")
  workspaceId String        @map("workspace_id")
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

// Tenant-owned: every row belongs to exactly one workspace. Read and written ONLY through the
// workspace-scoped client (src/prisma/tenant-client.ts). Never query this table with the plain client.
model Document {
  id           String         @id @default(uuid(7))
  workspaceId  String         @map("workspace_id")
  uploadedById String?        @map("uploaded_by_id") // kept as null if the uploader's account is deleted
  originalName String         @map("original_name") // display text only, untrusted. Never used as a path
  type         DocumentType
  sizeBytes    Int            @map("size_bytes")
  contentHash  String         @map("content_hash") // SHA-256 hex of the file bytes
  storageKey   String         @map("storage_key") // "<workspaceId>/<documentId>", generated by us
  status       DocumentStatus @default(UPLOADED)
  statusDetail String?        @map("status_detail") // plain-language reason when status is FAILED
  pageCount    Int?           @map("page_count") // set when READY. Formats without pages (TXT, DOCX) count as one page
  charCount    Int?           @map("char_count") // characters of cleaned text, set when READY
  processedAt  DateTime?      @map("processed_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  // Prisma sets this on every update. The worker's sweeper uses it to find documents nobody has touched for a while.
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at")

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  pages      DocumentPage[]
  chunks     DocumentChunk[]

  // The same file cannot be uploaded twice to one workspace. Different workspaces may hold the same file.
  @@unique([workspaceId, contentHash])
  @@index([workspaceId, createdAt])
  @@map("documents")
}

// The cleaned text of one page of a document, written by the processing worker (Milestone 4).
// Tenant-owned, like Document: only reached through the workspace-scoped client. Formats without pages
// (TXT, DOCX) have one row with pageNumber 1. Pages are stored separately so citations can name a page.
model DocumentPage {
  id          String   @id @default(uuid(7))
  workspaceId String   @map("workspace_id")
  documentId  String   @map("document_id")
  pageNumber  Int      @map("page_number") // starts at 1
  text        String // may be empty: a blank page keeps its number
  charCount   Int      @map("char_count")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, pageNumber])
  @@index([workspaceId, documentId])
  @@map("document_pages")
}

// One piece of one page, sized for embedding and retrieval. Postgres is the source of truth: the vectors
// built from these rows (Milestone 5, Checkpoint C, and Qdrant in Milestone 6) can always be rebuilt from here.
model DocumentChunk {
  id            String   @id @default(uuid(7))
  workspaceId   String   @map("workspace_id")
  documentId    String   @map("document_id")
  pageNumber    Int      @map("page_number") // a chunk never crosses a page
  chunkIndex    Int      @map("chunk_index") // order within the document, from 0
  strategy      String // "paragraph" or "fixed". Both can exist for one document (Milestone 6 compares them)
  startChar     Int      @map("start_char") // position inside that page's text: page.text.slice(startChar, endChar) === text
  endChar       Int      @map("end_char")
  text          String
  tokenEstimate Int      @map("token_estimate") // characters / 4
  contentHash   String   @map("content_hash") // SHA-256 of the text, the embedding cache key (Checkpoint C)
  createdAt     DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, strategy, chunkIndex])
  @@index([workspaceId, documentId])
  @@map("document_chunks")
}
