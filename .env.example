# Copy to .env and fill in. .env is git-ignored. Never commit a real key.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs are set in M1 after listing the models your key can use.
# Pin exact versions for anything that gets evaluated. No -latest aliases.
GEMINI_GENERATION_MODEL=
GEMINI_EMBEDDING_MODEL=
# Vector size. Fixed by the embedding model. Changing it means re-embedding everything.
EMBEDDING_DIMENSIONS=

# Client-side throttling, set a little under the free-tier limits shown at https://aistudio.google.com/rate-limit
# (the quota belongs to the Google project, so other tools on the same project share it).
GEMINI_GENERATION_RPM=
GEMINI_EMBEDDING_RPM=
# Embeddings are limited by tokens per minute, and that binds first. Keep it at or a little under the limit shown in AI Studio.
GEMINI_EMBEDDING_TPM=30000
GEMINI_MAX_RETRIES=5

DATABASE_URL=postgresql://akp:akp_dev_password@localhost:5433/akp
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

API_PORT=3001

# Session cookie signing key, min 32 random characters. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_DAYS=7

# Uploads. STORAGE_DIR defaults to <project>/storage (git-ignored).
MAX_UPLOAD_MB=10
# STORAGE_DIR=

# Background processing. The worker reads uploaded files and stores their text.
QUEUE_PREFIX=akp
WORKER_CONCURRENCY=2
MAX_PDF_PAGES=300
PROCESSING_TIMEOUT_SECONDS=60

# Chunking (Milestone 5). Sizes are in estimated tokens (characters / 4). Starting guesses: Milestone 6 measures them.
# CHUNK_STRATEGY is "paragraph" or "fixed". Changing any of these only affects new documents: run
# `bun run --cwd apps/api chunks:rebuild` to cut the documents that are already Ready again.
CHUNK_STRATEGY=paragraph
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=60
